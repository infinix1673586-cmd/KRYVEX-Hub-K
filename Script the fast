--====================================================
-- HELPERS
--====================================================

local function Theme()
	return Config.Tiers[State.Tier].Color
end

local function Tween(obj, time, props, style)
	local t = TweenService:Create(
		obj,
		TweenInfo.new(time, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		props
	)
	t:Play()
	return t
end

local function RandVec(j)
	return Vector3.new(
		(math.random() - 0.5) * 2 * j,
		(math.random() - 0.5) * 2 * j,
		(math.random() - 0.5) * 2 * j
	)
end

local function SetupCharacter(char)
	Character = char
	Humanoid = char:WaitForChild("Humanoid")
	Root = char:WaitForChild("HumanoidRootPart")
	OriginalSpeed = Humanoid.WalkSpeed
end

SetupCharacter(Player.Character or Player.CharacterAdded:Wait())

local function FeetOffset()
	if Humanoid.RigType == Enum.HumanoidRigType.R15 then
		return Humanoid.HipHeight + Root.Size.Y / 2
	end
	return 3
end

local function FeetPos()
	return Root.Position - Vector3.new(0, FeetOffset() - 0.1, 0)
end

-- container for all world effects
local FXFolder = workspace:FindFirstChild("KRYVEX_FLASH_FX")
if FXFolder then FXFolder:Destroy() end
FXFolder = Instance.new("Folder")
FXFolder.Name = "KRYVEX_FLASH_FX"
FXFolder.Parent = workspace

local function NewPart(color, transparency)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Transparency = transparency or 0
	return p
end

--====================================================
-- SOUND
--====================================================

local function PlaySound(id, volume, pitch, delay)
	if not id or id == "" or not Root then return end

	local function go()
		if not Root or not Root.Parent then return end
		local s = Instance.new("Sound")
		s.SoundId = id
		s.Volume = volume * Config.Volume
		s.PlaybackSpeed = pitch
		s.RollOffMaxDistance = 200
		s.Parent = Root
		s:Play()
		Debris:AddItem(s, 5)
	end

	if delay and delay > 0 then
		task.delay(delay, go)
	else
		go()
	end
end

-- ตอนแปลงร่าง: เสียงเก่าสามชั้น ทุ้มต่ำ + กลาง + แหลมแตก
local function ThunderStrike(power)
	power = power or 1
	PlaySound(Config.Sounds.Thunder, 2.0 * power, 0.55)
	PlaySound(Config.Sounds.Thunder, 1.2 * power, 1.4, 0.08)
	PlaySound(Config.Sounds.Thunder, 0.8 * power, 2.0, 0.18)
end

-- ตอนวิ่ง: เสียงของมึง
local function ZapSound()
	PlaySound(
		Config.Sounds.Zap,
		0.25 + State.Tier * 0.1,
		1.8 + math.random() * 0.9
	)
end

