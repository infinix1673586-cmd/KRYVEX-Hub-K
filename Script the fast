local function MakeTrail(part, p0, p1, life, c0, c1)
	local a0 = Instance.new("Attachment")
	a0.Position = p0
	a0.Parent = part
	local a1 = Instance.new("Attachment")
	a1.Position = p1
	a1.Parent = part

	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = life
	trail.MinLength = 0.1
	trail.FaceCamera = true
	trail.LightEmission = 1
	trail.Color = ColorSequence.new(c0, c1)
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.WidthScale = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(1, 0),
	})
	trail.Parent = part

	table.insert(Effects, a0)
	table.insert(Effects, a1)
	table.insert(Effects, trail)
end

local LimbNames = {
	"LeftHand", "RightHand", "LeftFoot", "RightFoot",
	"Left Arm", "Right Arm", "Left Leg", "Right Leg",
}

local function BuildEffects()
	local c = Theme()
	table.clear(Emitters)

	local att = Instance.new("Attachment")
	att.Name = "FlashAttachment"
	att.Parent = Root
	table.insert(Effects, att)

	local sparks = Instance.new("ParticleEmitter")
	sparks.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparks.Color = ColorSequence.new(WHITE, c)
	sparks.Rate = 60 + State.Tier * 40
	sparks.Lifetime = NumberRange.new(0.15, 0.4)
	sparks.Speed = NumberRange.new(6, 16)
	sparks.SpreadAngle = Vector2.new(180, 180)
	sparks.Drag = 4
	sparks.LightEmission = 1
	sparks.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.4),
		NumberSequenceKeypoint.new(1, 0),
	})
	sparks.Enabled = false
	sparks.Parent = att
	table.insert(Effects, sparks)
	table.insert(Emitters, sparks)

	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
	smoke.Color = ColorSequence.new(c)
	smoke.Transparency = NumberSequence.new(0.75, 1)
	smoke.Rate = 18
	smoke.Lifetime = NumberRange.new(0.3, 0.6)
	smoke.Speed = NumberRange.new(2, 5)
	smoke.Enabled = false
	smoke.Parent = att
	table.insert(Effects, smoke)
	table.insert(Emitters, smoke)

	-- 🌫️ DUST ที่พื้น (attachment อยู่ที่เท้า)
	local feetAtt = Instance.new("Attachment")
	feetAtt.Name = "FlashDustAttachment"
	feetAtt.Position = Vector3.new(0, -(FeetOffset() - 0.1), 0)
	feetAtt.Parent = Root
	table.insert(Effects, feetAtt)

	local dust = Instance.new("ParticleEmitter")
	dust.Name = "FlashDust"
	dust.Texture = "rbxasset://textures/particles/smoke_main.dds"
	dust.Color = ColorSequence.new(Color3.fromRGB(170, 160, 145))
	dust.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.45),
		NumberSequenceKeypoint.new(1, 1),
	})
	dust.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1.5),
		NumberSequenceKeypoint.new(1, 5 + State.Tier),
	})
	dust.Lifetime = NumberRange.new(0.5, 1)
	dust.Speed = NumberRange.new(3, 8)
	dust.SpreadAngle = Vector2.new(35, 35)
	dust.EmissionDirection = Enum.NormalId.Top
	dust.Acceleration = Vector3.new(0, 2, 0)
	dust.Rotation = NumberRange.new(0, 360)
	dust.RotSpeed = NumberRange.new(-60, 60)
	dust.Rate = 30 + State.Tier * 25
	dust.LockedToPart = false
	dust.Enabled = false
	dust.Parent = feetAtt
	table.insert(Effects, dust)
	DustEmitter = dust

	-- main body trail
	MakeTrail(Root, Vector3.new(0, 1.4, 0.4), Vector3.new(0, -1.4, 0.4), 0.4, c, WHITE)

	-- limb trails
	for _, name in ipairs(LimbNames) do
		local limb = Character:FindFirstChild(name)
		if limb and limb:IsA("BasePart") then
			MakeTrail(limb, Vector3.new(0, 0.5, 0), Vector3.new(0, -0.5, 0), 0.25, c, c)
		end
	end

	-- glow
	local hl = Instance.new("Highlight")
	hl.FillColor = c
	hl.OutlineColor = WHITE
	hl.FillTransparency = 0.85
	hl.OutlineTransparency = 0.1
	hl.Parent = Character
	table.insert(Effects, hl)

	local light = Instance.new("PointLight")
	light.Color = c
	light.Brightness = 3
	light.Range = 18
	light.Parent = Root
	table.insert(Effects, light)
end

local function ClearEffects()
	for _, obj in ipairs(Effects) do
		if obj and obj.Parent then
			obj:Destroy()
		end
	end
	table.clear(Effects)
	table.clear(Emitters)
	DustEmitter = nil
end

local function SetEmitters(on)
	for _, e in ipairs(Emitters) do
		e.Enabled = on
	end
end

--====================================================
-- GHOST WALK
--====================================================

local function SetGhost(enabled)
	if not Character then return end

	if enabled then
		table.clear(OriginalCollision)
		for _, part in ipairs(Character:GetDescendants()) do
			if part:IsA("BasePart") then
				OriginalCollision[part] = part.CanCollide
				part.CanCollide = false
			end
		end
		GhostApplied = true
	else
		GhostApplied = false
		for part, original in pairs(OriginalCollision) do
			if part and part.Parent then
				part.CanCollide = original
			end
		end
		table.clear(OriginalCollision)
	end
end

-- Humanoid resets CanCollide, so force it every physics step
RunService.Stepped:Connect(function()
	if GhostApplied then
		for part in pairs(OriginalCollision) do
			if part and part.Parent then
				part.CanCollide = false
			end
		end
	end
end)

--====================================================
-- ACTIVATE / DEACTIVATE
--====================================================

local UpdateUI

local function Activate()
	if State.Active or not Humanoid or not Root then return end
	State.Active = true
	FOVReturning = false
	OriginalFOV = Camera.FieldOfView

	BuildEffects()
	if State.Ghost then SetGhost(true) end
	SetFX(true)
	ApplyScreen(false) -- สีจางๆ ค้างจอตอนเปิดโหมด (ถ้าเปิดสีหน้าจออยู่)

	Shockwave(FeetPos(), 22, 0.1)
	for _ = 1, 6 do
		Bolt(Root.Position, Root.Position + RandVec(9), 5, 1.6, 0.18)
	end
	if DustEmitter then DustEmitter:Emit(40) end

	-- ⚡ ฟ้าผ่าตอนแปลงร่าง
	ThunderStrike(1.2)

	UpdateUI()
end

local function Deactivate()
	if not State.Active then return end
	State.Active = false
	WasMoving = false

	if Humanoid then
		Humanoid.WalkSpeed = OriginalSpeed
		Humanoid.CameraOffset = Vector3.zero
	end

	SetGhost(false)
	SetFX(false)
	ClearEffects()
	Tween(Vignette, 0.3, { GroupTransparency = 1 })
	Tween(Tint, 0.3, { BackgroundTransparency = 1 })
	FOVReturning = true

	UpdateUI()
end

local function SetTier(i)
	State.Tier = i
	if State.Active then
		ClearEffects()
		BuildEffects()
		SetFX(true)
		Shockwave(FeetPos(), 26, 0.12)
		for _ = 1, 4 do
			Bolt(Root.Position, Root.Position + RandVec(10), 5, 1.8, 0.2)
		end
		if DustEmitter then DustEmitter:Emit(30) end
		ThunderStrike(0.8 + i * 0.2)
	end
	UpdateUI()
end

local function ToggleScreen()
	State.Screen = not State.Screen
	ApplyScreen(WasMoving)
	UpdateUI()
end

--====================================================
-- MAIN LOOP
--====================================================

local LastAfter, LastBolt, LastRing, LastStreak, LastGround, LastBoom = 0, 0, 0, 0, 0, 0
local LastZap, LastFloor = 0, 0
local LastReadout = 0
local Readout -- set by UI

RunService.RenderStepped:Connect(function(dt)
	if not Character or not Character.Parent or not Humanoid or not Root then return end

	local now = os.clock()
	local tier = Config.Tiers[State.Tier]
	local v = Root.AssemblyLinearVelocity
	local speed = Vector3.new(v.X, 0, v.Z).Magnitude

	if Readout and now - LastReadout > 0.1 then
		LastReadout = now
		Readout.Text = string.format("%d studs/s", speed)
	end

	-- FOV
	if State.Active then
		local frac = math.clamp(speed / tier.Speed, 0, 1)
		local target = OriginalFOV + (tier.FOV - OriginalFOV) * frac
		Camera.FieldOfView += (target - Camera.FieldOfView) * (1 - math.exp(-dt * 7))
	elseif FOVReturning then
		Camera.FieldOfView += (OriginalFOV - Camera.FieldOfView) * (1 - math.exp(-dt * 7))
		if math.abs(Camera.FieldOfView - OriginalFOV) < 0.2 then
			Camera.FieldOfView = OriginalFOV
			FOVReturning = false
		end
	end

	if not State.Active then return end

	-- acceleration ramp
	Humanoid.WalkSpeed += (tier.Speed - Humanoid.WalkSpeed) * (1 - math.exp(-dt * 5))

	local dir = Humanoid.MoveDirection
	local moving = dir.Magnitude > 0.1

	if moving ~= WasMoving then
		SetEmitters(moving)
		ApplyScreen(moving) -- 🎨 วิ่ง = เข้ม / นิ่ง = จาง / ปิดสี = ไม่มี
		if moving then StartBurst() end
		WasMoving = moving
	end

	if moving then
		dir = dir.Unit

		-- camera shake
		local s = 0.025 * State.Tier
		Humanoid.CameraOffset = Vector3.new(
			(math.random() - 0.5) * s * 2,
			(math.random() - 0.5) * s * 2,
			0
		)

		-- 🌫️ สีฝุ่นตามสีพื้นที่เหยียบ
		if now - LastFloor > 0.15 then
			LastFloor = now
			FloorParams.FilterDescendantsInstances = { Character, FXFolder }
			local hit = workspace:Raycast(Root.Position, Vector3.new(0, -10, 0), FloorParams)
			if hit and DustEmitter then
				local base
				if hit.Instance:IsA("Terrain") then
					base = Color3.fromRGB(150, 130, 100)
				else
					base = hit.Instance.Color
				end
				DustEmitter.Color = ColorSequence.new(
					base:Lerp(Color3.fromRGB(200, 200, 200), 0.45)
				)
			end
		end

		local grounded = Humanoid.FloorMaterial ~= Enum.Material.Air
		if DustEmitter then
			DustEmitter.Enabled = grounded
		end

		if now - LastAfter > (0.09 - State.Tier * 0.02) then
			LastAfter = now
			AfterImage()
		end

		if now - LastBolt > 0.06 then
			LastBolt = now
			BodyBolts()
		end

		if now - LastGround > 0.1 then
			LastGround = now
			GroundBolt(dir)
		end

		if now - LastRing > Config.GroundInterval then
			LastRing = now
			Shockwave(FeetPos(), 11, 0.08)
			if DustEmitter and grounded then
				DustEmitter:Emit(8)
			end
		end

		if now - LastStreak > 0.04 then
			LastStreak = now
			SpeedStreak(dir)
		end

		-- 🔊 ซ่าตอนวิ่ง (ถี่ขึ้นตาม tier)
		if now - LastZap > (0.55 - State.Tier * 0.12) then
			LastZap = now
			ZapSound()
		end

		if State.Tier == 3 and speed > tier.Speed * 0.8 and now - LastBoom > 0.6 then
			LastBoom = now
			SonicBoom(Root.Position + dir * 4, dir)
		end
	else
		Humanoid.CameraOffset = Humanoid.CameraOffset:Lerp(Vector3.zero, 0.3)
		if DustEmitter then
			DustEmitter.Enabled = false
		end
	end
end)

