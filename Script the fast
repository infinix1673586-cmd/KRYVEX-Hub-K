local Edges = {}
local function Edge(pos, size, rot)
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.Position = pos
	f.Size = size
	f.BackgroundColor3 = Theme()
	f.Active = false
	local g = Instance.new("UIGradient")
	g.Rotation = rot
	g.Transparency = NumberSequence.new(0.35, 1)
	g.Parent = f
	f.Parent = Vignette
	table.insert(Edges, f)
end

Edge(UDim2.fromScale(0, 0), UDim2.fromScale(1, 0.28), 90)     -- top
Edge(UDim2.fromScale(0, 0.72), UDim2.fromScale(1, 0.28), 270) -- bottom
Edge(UDim2.fromScale(0, 0), UDim2.fromScale(0.2, 1), 0)       -- left
