-- 🎨 ใช้สีหน้าจอตามสถานะ (เปิด/ปิด + วิ่ง/นิ่ง)
local function ApplyScreen(moving)
	if not State.Active then return end
	if State.Screen then
		Tween(Tint, 0.3, { BackgroundTransparency = moving and Config.ScreenTint or Config.IdleTint })
		Tween(Vignette, 0.3, { GroupTransparency = moving and 0.35 or 0.75 })
		Tween(CC, 0.3, { TintColor = WHITE:Lerp(Theme(), 0.4) })
	else
		Tween(Tint, 0.3, { BackgroundTransparency = 1 })
		Tween(Vignette, 0.3, { GroupTransparency = 1 })
		Tween(CC, 0.3, { TintColor = WHITE })
	end
end

