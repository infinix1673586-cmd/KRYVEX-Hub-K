local Blur = Instance.new("BlurEffect")
Blur.Name = "KryvexFlashBlur"
Blur.Size = 0
Blur.Parent = Lighting

local function SetFX(on)
	if on then
		Tween(Bloom, 0.4, { Intensity = 1.2 })
		Tween(CC, 0.4, {
			Saturation = 0.25,
			Contrast = 0.12,
			TintColor = State.Screen and WHITE:Lerp(Theme(), 0.4) or WHITE,
		})
		Tween(Blur, 0.4, { Size = 4 })
	else
		Tween(Bloom, 0.4, { Intensity = 0 })
		Tween(CC, 0.4, { Saturation = 0, Contrast = 0, TintColor = WHITE })
		Tween(Blur, 0.4, { Size = 0 })
	end
end

