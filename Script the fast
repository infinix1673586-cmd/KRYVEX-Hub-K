local function Shockwave(pos, maxSize, thickness)
	local ring = NewPart(Theme(), 0.1)
	ring.Name = "FlashRing"
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(thickness or 0.1, 3, 3)
	ring.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = FXFolder

	Tween(ring, 0.5, {
		Size = Vector3.new(0.03, maxSize, maxSize),
		Transparency = 1,
	})
	Debris:AddItem(ring, 0.55)
end

local function SonicBoom(pos, dir)
	local ring = NewPart(WHITE, 0.2)
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.15, 6, 6)
	ring.CFrame = CFrame.lookAt(pos, pos + dir) * CFrame.Angles(0, math.rad(90), 0)
	ring.Parent = FXFolder

	Tween(ring, 0.4, {
		Size = Vector3.new(0.05, 34, 34),
		Transparency = 1,
	})
	Debris:AddItem(ring, 0.45)

	PlaySound(Config.Sounds.Boom, 1.5, 0.5)
end

local function Segment(a, b, thick, color)
	local d = (b - a).Magnitude
	if d < 0.05 then return end
	local p = NewPart(color, 0.05)
	p.Size = Vector3.new(thick, thick, d)
	p.CFrame = CFrame.lookAt(a, b) * CFrame.new(0, 0, -d / 2)
	p.Parent = FXFolder
	Tween(p, 0.18, { Transparency = 1 })
	Debris:AddItem(p, 0.22)
end

local function Bolt(a, b, segs, jitter, thick)
	local pts = { a }
	for i = 1, segs - 1 do
		pts[#pts + 1] = a:Lerp(b, i / segs) + RandVec(jitter)
	end
	pts[#pts + 1] = b

	for i = 1, #pts - 1 do
		Segment(pts[i], pts[i + 1], thick, Theme())
		Segment(pts[i], pts[i + 1], thick * 0.4, WHITE)
	end
end

local function BodyBolts()
	for _ = 1, State.Tier do
		local origin = Root.Position + RandVec(1.5)
		local target = Root.Position + RandVec(7) + Vector3.new(0, 1, 0)
		Bolt(origin, target, 5, 1.4, 0.14)
	end
end

local function GroundBolt(dir)
	local feet = FeetPos()
	local side = Vector3.new(-dir.Z, 0, dir.X) * (math.random() - 0.5) * 6
	local target = feet - dir * math.random(8, 18) + side
	Bolt(feet, target, 6, 1.1, 0.18)
end

local function AfterImage()
	for _, part in ipairs(Character:GetChildren()) do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Transparency < 1 then
			local g = NewPart(Theme(), 0.45)
			g.Size = part.Size
			g.CFrame = part.CFrame
			g.Parent = FXFolder
			Tween(g, 0.4, { Transparency = 1 })
			Debris:AddItem(g, 0.45)
		end
	end
end

local function SpeedStreak(dir)
	local len = math.random(6, 14)
	local offset = Camera.CFrame.RightVector * math.random(-12, 12)
		+ Vector3.new(0, math.random(-4, 8), 0)
		+ dir * math.random(10, 30)
	local pos = Root.Position + offset

	local line = NewPart(WHITE:Lerp(Theme(), 0.4), 0.3)
	line.Size = Vector3.new(0.05, 0.05, len)
	line.CFrame = CFrame.lookAt(pos, pos + dir)
	line.Parent = FXFolder

	local endPos = pos - dir * 50
	Tween(line, 0.3, {
		CFrame = CFrame.lookAt(endPos, endPos + dir),
		Transparency = 1,
	})
	Debris:AddItem(line, 0.35)
end

local function StartBurst()
	Shockwave(FeetPos(), 14, 0.1)
	for _ = 1, 4 do
		local o = Root.Position
		Bolt(o, o + RandVec(8), 5, 1.5, 0.16)
	end
	if DustEmitter then DustEmitter:Emit(25) end
	-- ออกตัว = เสียงตอนวิ่ง (ของมึง)
	PlaySound(Config.Sounds.Zap, 0.9, 1.1)
	PlaySound(Config.Sounds.Zap, 0.6, 2.4, 0.05)
end

